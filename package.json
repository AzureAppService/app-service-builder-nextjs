{
  "name": "app-service-builder-nextjs",
  "description": "Standalone Next.js App Router sample for Azure App Service Builder.",
  "license": "MIT",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run prepare:standalone",
    "start": "next start -H 0.0.0.0",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "test": "node --test standalone.test.mjs",
    "verify": "pwsh -NoProfile -File scripts/verify.ps1 -BaseUrl http://127.0.0.1:3000"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "eslint": "^10",
    "eslint-config-next": "16.4.4"
  }
}
